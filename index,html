        /**
         * 횟수(수량) 변경 버튼 핸들러
         */
        function changeQuantity(procedureId, delta) {
            const inputElement = document.getElementById(`quantity-${procedureId}`);
            if (!inputElement) return;

            let currentQuantity = parseInt(inputElement.value, 10);
            let newQuantity = currentQuantity + delta;

            // 1~9 범위로 제한
            if (newQuantity < 1) newQuantity = 1;
            if (newQuantity > 9) newQuantity = 9; 

            // 수량 업데이트 및 전체 목록/카트 갱신
            updateQuantity(procedureId, newQuantity);
        }

        /**
         * 횟수(수량) 변경 핸들러
         */
        function updateQuantity(procedureId, newQuantity) {
            let quantity = parseInt(newQuantity, 10);
            
            // 1~9 범위로 제한
            if (isNaN(quantity) || quantity < 1) {
                quantity = 1;
            } else if (quantity > 9) {
                quantity = 9; 
            }
            
            // Input 요소의 값 업데이트
            const inputElement = document.getElementById(`quantity-${procedureId}`);
            if (inputElement) {
                inputElement.value = quantity;
            }

            const proc = allProceduresData.find(p => p.id === procedureId);
            if (!proc) return;

            const newTotalTaxIncluded = calculateTotalTaxIncludedPrice(proc.price, quantity);
            
            // 1. 시술 목록의 합계 업데이트
            const totalDisplayElement = document.getElementById(`total-${proc.id}`);
            if (totalDisplayElement) {
                totalDisplayElement.textContent = formatPrice(newTotalTaxIncluded);
            }

            // 2. 카트에 있다면 카트 상태 업데이트
            if (cart[procedureId]) {
                cart[procedureId].quantity = quantity;
                cart[procedureId].totalTaxIncludedPrice = newTotalTaxIncluded;
                updateCart(); // 카트 목록 및 최종 금액 갱신
            }
        }

        /**
         * 시술 항목 체크박스 변경 핸들러 (카트 추가/제거 - 좌측 목록)
         */
        function handleCartCheckboxChange(procedureId) {
            const checkbox = document.getElementById(`check-${procedureId}`);
            const isChecked = checkbox.checked;
            const proc = allProceduresData.find(p => p.id === procedureId);

            if (!proc) {
                console.error('Procedure not found:', procedureId);
                return;
            }
            
            // 현재 수량 필드에서 수량 가져오기 (기본값 1)
            const quantityInput = document.getElementById(`quantity-${procedureId}`);
            const currentQuantity = quantityInput ? parseInt(quantityInput.value, 10) : 1;

            if (isChecked) {
                // 카트에 추가 (현재 수량 반영)
                cart[procedureId] = {
                    id: proc.id, 
                    name: proc.name,
                    price: proc.price,
                    quantity: currentQuantity,
                    totalTaxIncludedPrice: calculateTotalTaxIncludedPrice(proc.price, currentQuantity),
                    checked: true 
                };
            } else {
                // 카트에서 제거
                delete cart[procedureId];
            }

            // Checkbox의 시각적 상태 업데이트 (좌측)
            const visualCheckbox = checkbox.nextElementSibling; 
            
            if (visualCheckbox) {
                if (isChecked) {
                    visualCheckbox.classList.add('bg-pink-500', 'border-pink-500');
                    visualCheckbox.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 13.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>';
                } else {
                    visualCheckbox.classList.remove('bg-pink-500', 'border-pink-500');
                    visualCheckbox.innerHTML = '';
                }
            }


            updateCart();
        }

        /**
         * 우측 시술 목록 체크박스 변경 핸들러 (최종 결제 금액 포함/제외)
         */
        function handleCartItemCheckChange(procedureId) {
            const checkbox = document.getElementById(`cart-check-${procedureId}`);
            const isChecked = checkbox.checked;

            if (cart[procedureId]) {
                cart[procedureId].checked = isChecked; // 카트 데이터의 checked 상태 업데이트
            }
            
            // 시각적 상태 업데이트
            const visualCheckbox = checkbox.nextElementSibling;

            if (visualCheckbox) {
                if (isChecked) {
                    visualCheckbox.classList.add('bg-pink-500', 'border-pink-500');
                    visualCheckbox.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 13.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>';
                } else {
                    visualCheckbox.classList.remove('bg-pink-500', 'border-pink-500');
                    visualCheckbox.innerHTML = '';
                }
            }


            updateCart(); // 최종 금액 재계산
        }

        /**
         * 카트 목록과 최종 금액을 업데이트합니다.
         */
        function updateCart() {
            let totalAmount = 0;
            const selectedItems = Object.values(cart);

            // 1. 카트 목록 업데이트
            if (selectedItems.length === 0) {
                cartList.innerHTML = '';
                emptyCartMessage.classList.remove('hidden');
                finalTotalContainer.classList.add('hidden'); // 카트가 비면 최종 금액 숨기기
            } else {
                emptyCartMessage.classList.add('hidden');
                finalTotalContainer.classList.remove('hidden'); // 카트가 있으면 최종 금액 표시

                cartList.innerHTML = selectedItems.map(item => {
                    // 카트 항목이 'checked: true' 일 때만 합산
                    if (item.checked) {
                        totalAmount += item.totalTaxIncludedPrice;
                    }

                    // Helper function for visual checkbox rendering (for right panel)
                    const renderVisualCartCheckbox = (id, checked) => `
                        <label for="cart-check-${id}" class="cursor-pointer flex justify-center items-center h-full">
                            <input type="checkbox" id="cart-check-${id}" class="form-checkbox h-4 w-4 text-pink-600 rounded focus:ring-pink-500 cursor-pointer hidden" onchange="handleCartItemCheckChange('${id}')" ${checked ? 'checked' : ''}>
                            <div class="w-4 h-4 border border-pink-400 rounded transition duration-150 ease-in-out flex items-center justify-center ${checked ? 'bg-pink-500 border-pink-500' : 'bg-white'}">
                                ${checked ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 13.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>' : ''}
                            </div>
                        </label>
                    `;


                    // Right panel rendering updated with text-left/text-right alignment
                    return `
                        <div class="grid grid-cols-12 items-center text-sm text-gray-800 py-3 border-b border-gray-100">
                            <!-- Checkbox (col-span-1) -->
                            <div class="col-span-1">
                                ${renderVisualCartCheckbox(item.id, item.checked)}
                            </div>
                            <!-- Name (col-span-7) - Left Aligned, 1. 시술명 줄바꿈 허용 -->
                            <div class="col-span-7 text-left pl-2 pr-1 cart-item-name ${item.checked ? '' : 'text-gray-400 italic line-through'}">${item.name}</div>
                            <!-- Price (col-span-2) - Right Aligned -->
                            <div class="col-span-2 text-right text-gray-600 ${item.checked ? '' : 'text-gray-400 italic'}">${formatPrice(item.price)}</div>
                            <!-- Quantity (col-span-1) - Right Aligned -->
                            <div class="col-span-1 text-right ${item.checked ? '' : 'text-gray-400 italic'}">${item.quantity}</div>
                            <!-- Total (col-span-1) - Right Aligned, 2. 합계금액 오른쪽 정렬 -->
                            <div class="col-span-1 text-right font-semibold text-gray-700 pr-3 ${item.checked ? '' : 'text-gray-400 italic'}">${formatPrice(item.totalTaxIncludedPrice)}</div>
                        </div>
                    `;
                }).join('');
            }

            // 2. 최종 금액 업데이트
            finalTotalDisplay.textContent = formatPrice(totalAmount) + '원';
        }

        /**
         * 하트 아이콘 토글: 시술 항목을 위시리스트에 추가/제거하고 아이콘을 변경합니다.
         */
        function toggleWishlist(procedureId) {
            const heartIconElement = document.getElementById(`heart-${procedureId}`);
            const isFavorited = !!wishlist[procedureId];

            if (isFavorited) {
                delete wishlist[procedureId];
            } else {
                wishlist[procedureId] = true;
            }

            // 아이콘 상태는 renderProcedureList에서 일괄 갱신됩니다.
            renderProcedureList();
        }

        /**
         * 위시리스트 버튼 토글: 시술 목록을 전체 보기와 위시리스트 보기로 전환합니다.
         */
        function toggleWishlistView() {
            isWishlistView = !isWishlistView;
            
            // 1. 헤더 아이콘 스타일 변경
            if (isWishlistView) {
                // Set the header heart icon to be filled pink when viewing wishlist
                wishlistToggleButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#EC4899" stroke="#EC4899" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
                wishlistToggleButton.classList.add('text-pink-600');
                
                // Point 4: 타이틀 변경
                procedureListTitle.textContent = '관심시술';
                
                // 메뉴탭 비활성화 (위시리스트 뷰에서는 카테고리 필터 무시)
                menuTabs.forEach(tab => tab.classList.remove('active-menu', 'text-white'));

            } else {
                // Set the header heart icon back to outline when viewing all
                wishlistToggleButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
                wishlistToggleButton.classList.remove('text-pink-600');
                
                // Point 4: 타이틀 복구
                procedureListTitle.textContent = currentCategoryName;
                
                // 현재 카테고리 메뉴탭 활성화
                const activeTab = document.getElementById(`menu-${currentCategory}`);
                if (activeTab) {
                    activeTab.classList.add('active-menu');
                }
            }

            // 2. 시술 목록 필터링 및 렌더링
            renderProcedureList();
        }
        
        // --- 4. 검색 기능 추가 ---

        /**
         * 검색 입력란 표시/숨기기 토글
         */
        function toggleSearchInput() {
            isSearchVisible = !isSearchVisible;

            if (isSearchVisible) {
                // Show search bar
                searchContainer.style.visibility = 'visible';
                searchContainer.style.opacity = 1;
                searchInput.focus();
            } else {
                // Hide search bar
                searchContainer.style.visibility = 'hidden';
                searchContainer.style.opacity = 0;
                searchInput.value = ''; // Clear input
                searchResultsDropdown.classList.add('hidden'); // Hide results
            }
        }

        /**
         * 검색어 입력 시 드롭다운 결과 업데이트
         */
        function handleSearchInput() {
            const query = searchInput.value.toLowerCase().trim();
            
            if (query.length < 2) {
                searchResultsDropdown.classList.add('hidden');
                return;
            }

            const searchResults = allProceduresData.filter(proc => 
                proc.name.toLowerCase().includes(query)
            );

            renderSearchResults(searchResults);
        }

        /**
         * 검색 결과를 드롭다운에 렌더링
         */
        function renderSearchResults(results) {
            if (results.length === 0) {
                searchResultsDropdown.innerHTML = `
                    <div class="p-3 text-sm text-gray-500">검색 결과가 없습니다.</div>
                `;
                searchResultsDropdown.classList.remove('hidden');
                return;
            }

            searchResultsDropdown.innerHTML = results.map(proc => {
                const totalTaxIncluded = calculateTotalTaxIncludedPrice(proc.price, 1);
                
                // 클릭 시 해당 시술의 카테고리로 이동하고 카트에 추가
                return `
                    <div class="flex justify-between items-center p-3 text-xs border-b border-gray-100 cursor-pointer hover:bg-pink-50 transition" 
                         onclick="selectSearchResult('${proc.category}', '${proc.name}')">
                        
                        <!-- 시술명 -->
                        <span class="font-medium text-gray-800 flex-1 truncate pr-2">${proc.name}</span>
                        
                        <!-- 가격 -->
                        <span class="text-right text-pink-600">${formatPrice(proc.price)}원</span>
                    </div>
                `;
            }).join('');
            
            searchResultsDropdown.classList.remove('hidden');
        }

        /**
         * 검색 결과 클릭 시 해당 카테고리로 이동하는 함수 (현재는 카테고리 이동만)
         */
        function selectSearchResult(category, name) {
            // 1. 드롭다운 닫기 및 검색 필드 초기화
            toggleSearchInput(); 
            
            // 2. 해당 카테고리로 필터 변경 및 렌더링
            const categoryName = document.getElementById(`menu-${category}`).textContent;
            setCategoryFilter(category, categoryName + ' 시술 목록'); // Use stored name or default

            // 선택된 항목 강조 등의 추가 작업은 필요 시 구현
            console.log(`Selected procedure: ${name} in category: ${category}`);
        }

        // 초기화
        window.onload = () => {
            // 초기 카테고리 (한정 이벤트) 설정 및 렌더링
            setCategoryFilter(currentCategory, currentCategoryName);
            updateCart(); // 초기 화면에서 카트 비어 있음 표시
        };

    </script>
</body>
</html>
