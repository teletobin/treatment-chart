                if (isWishlistView) {
                    return wishlistMatch;
                }
                // 일반 뷰일 때는 선택된 카테고리 항목만 보여줍니다.
                return categoryMatch;
            });

            // 위시리스트 뷰이지만 필터링된 항목이 없는 경우
            if (isWishlistView && Object.keys(wishlist).length === 0) {
                 procedureList.innerHTML = `<p class="text-center text-gray-500 py-8 col-span-12">관심 시술 목록이 비어 있습니다.</p>`;
                 return;
            }
            
            // 일반 뷰이지만 필터링된 항목이 없는 경우
            if (filteredProcedures.length === 0) {
                 procedureList.innerHTML = `<p class="text-center text-gray-500 py-8 col-span-12">선택된 카테고리에 시술 항목이 없습니다.</p>`;
                 return;
            }

            procedureList.innerHTML = filteredProcedures.map(proc => {
                // 카트에 항목이 있으면 해당 수량을 사용하고, 없으면 기본값 1을 사용
                const currentQuantity = cart[proc.id] ? cart[proc.id].quantity : 1;
                const totalTaxIncludedPrice = calculateTotalTaxIncludedPrice(proc.price, currentQuantity);
                
                const isFavorited = !!wishlist[proc.id]; // Check current wishlist state
                const isChecked = !!cart[proc.id]; // Check current cart state in left panel

                // 하트 아이콘 SVG (채워진 하트 또는 테두리 하트)
                const heartIconSvg = isFavorited
                    ? `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#EC4899" stroke="#EC4899" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`
                    : `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart text-pink-500/70 hover:text-pink-500"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;

                // Helper function for visual checkbox rendering
                const renderVisualCheckbox = (id, checked) => `
                    <label for="check-${id}" class="cursor-pointer">
                        <input type="checkbox" id="check-${id}" class="form-checkbox h-4 w-4 text-pink-600 rounded focus:ring-pink-500 cursor-pointer hidden" onchange="handleCartCheckboxChange('${id}')" ${checked ? 'checked' : ''}>
                        <div class="w-4 h-4 border border-pink-400 rounded transition duration-150 ease-in-out flex items-center justify-center ${checked ? 'bg-pink-500 border-pink-500' : 'bg-white'}">
                            ${checked ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 13.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>' : ''}
                        </div>
                    </label>
                `;

                // 시술명 왼쪽 정렬, 가격/횟수/합계 오른쪽 정렬
                return `
                    <div class="procedure-item grid grid-cols-12 items-center text-sm text-gray-800 py-3 border-b border-pink-50/50 hover:bg-pink-50 transition" data-id="${proc.id}">
                        
                        <!-- Heart & Checkbox Container (col-span-1) -->
                        <div class="col-span-1 flex justify-center items-center space-x-1">
                            <!-- Wishlist Heart Toggle -->
                            <button onclick="toggleWishlist('${proc.id}')" class="wishlist-icon focus:outline-none" id="heart-${proc.id}" aria-label="Add to wishlist">
                                ${heartIconSvg}
                            </button>
                            
                            <!-- Checkbox: Visual element for checkbox -->
                            ${renderVisualCheckbox(proc.id, isChecked)}
                        </div>
                        
                        <!-- Procedure Name (col-span-7) - Left Aligned -->
                        <label for="check-${proc.id}" class="col-span-7 cursor-pointer text-left pl-2 pr-1">${proc.name}</label>
                        
                        <!-- Price (col-span-2) - Right Aligned -->
                        <div class="col-span-2 text-right text-gray-600">${formatPrice(proc.price)}</div>
                        
                        <!-- Quantity Control (col-span-1) - Right Aligned -->
                        <div class="col-span-1 flex justify-end pr-1">
                            <div class="quantity-control flex-row">
                                <input type="number" 
                                    id="quantity-${proc.id}" 
                                    value="${currentQuantity}" 
                                    min="1" 
                                    max="9" 
                                    readonly="readonly"
                                >
                                <div class="up-down-container">
                                    <button onclick="changeQuantity('${proc.id}', 1)" aria-label="Increase quantity">
                                        <svg xmlns="http://www.w3.org/2003/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucude-chevron-up"><path d="m18 15-6-6-6 6"/></svg>
