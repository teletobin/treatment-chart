        // VAT 10% 포함 금액을 계산하는 함수 (횟수 반영)
        const calculateTotalTaxIncludedPrice = (price, quantity) => Math.floor(price * quantity * 1.1);

        // 숫자 포맷 함수 (3자리마다 쉼표 추가)
        const formatPrice = (price) => price.toLocaleString('ko-KR');

        /**
