    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f7f7; /* Soft light background */
        }
        /* Custom styles for minimal quantity input (like the reference image) */
        .quantity-control {
            border: none;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            width: 36px; 
            height: 28px; 
            margin-left: auto; /* Right align in its grid column */
        }
        .quantity-control input {
            /* Number display */
            @apply text-center text-sm font-semibold bg-white p-0 border-0 text-gray-600;
            width: 16px; /* Narrower width for single digit */
            height: 100%;
            line-height: 26px; /* Adjust line height to match new height */
            -moz-appearance: textfield; /* Firefox: Remove arrows */
        }
        /* Hide default number input arrows in modern browsers */
        input[type='number']::-webkit-inner-spin-button, 
        input[type='number']::-webkit-outer-spin-button { 
            -webkit-appearance: none; 
            margin: 0; 
        }

        /* Up/Down Arrow Styling */
        .up-down-container {
            /* Adjust width for arrow column */
            @apply flex flex-col items-center justify-center h-full;
            width: 12px;
        }
        .up-down-container button {
            /* Button styling */
            @apply w-full h-1/2 text-[10px] text-gray-500 hover:text-gray-700 bg-gray-50 hover:bg-gray-100 transition duration-150;
            padding: 0;
            line-height: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
        }
        .up-down-container button:first-child { border-bottom: 1px solid #d1d5db; }
        
        /* Active Menu Styling */
        .active-menu {
            @apply bg-pink-600 text-white shadow-lg;
        }

        /* 1. 시술 목록의 시술명 줄바꿈 허용 (우측 카트 목록) */
        .cart-item-name {
